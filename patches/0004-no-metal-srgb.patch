+use super::*;
+
+#[test]
+fn explicit_webgpu_is_rejected_and_opengl_software_paths_remain_allowed() {
+    let error = ensure_front_end_supported(config::FrontEndSelection::WebGpu).unwrap_err();
+    assert!(error
+        .to_string()
+        .contains("WebGpu is unavailable in this Mavericks build"));
+    ensure_front_end_supported(config::FrontEndSelection::OpenGL).unwrap();
+    ensure_front_end_supported(config::FrontEndSelection::Software).unwrap();
+}
+
+#[test]
+fn lua_gpu_enumeration_reports_unavailable_instead_of_initializing_wgpu() {
+    use config::lua::{get_or_create_sub_module, mlua};
+    let lua = mlua::Lua::new();
+    crate::scripting::register(&lua).unwrap();
+    let gui = get_or_create_sub_module(&lua, "gui").unwrap();
+    let function: mlua::Function = gui.get("enumerate_gpus").unwrap();
+    let error = function.call::<(), mlua::Value>(()).unwrap_err();
+    assert!(error
+        .to_string()
+        .contains("WebGpu is unavailable in this Mavericks build"));
+}
