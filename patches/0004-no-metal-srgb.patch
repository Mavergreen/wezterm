+pub(crate) fn ensure_front_end_supported(
+    front_end: config::FrontEndSelection,
+) -> anyhow::Result<()> {
+    if matches!(front_end, config::FrontEndSelection::WebGpu) {
+        anyhow::bail!("WebGpu is unavailable in this Mavericks build; use OpenGL or Software");
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    include!("render_compat_tests.rs");
+}
