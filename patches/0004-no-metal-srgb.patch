@@ -0,0 +1,58 @@
+use super::*;
+use core_foundation::base::CFEqual;
+
+#[link(name = "QuartzCore", kind = "framework")]
+extern "C" {
+    fn CACurrentMediaTime() -> f64;
+}
+
+#[test]
+fn srgb_color_preserves_space_components_alpha() {
+    for components in [
+        [0., 0., 0., 0.],
+        [1., 1., 1., 1.],
+        [0.125, 0.375, 0.625, 0.875],
+    ] {
+        let color = create_srgb_color(components).unwrap();
+        let actual_space = CGColor::color_space(Some(&color)).unwrap();
+        let expected_space = CGColorSpace::with_name(Some(unsafe { kCGColorSpaceSRGB })).unwrap();
+        assert!(
+            unsafe {
+                CFEqual(
+                    (&*actual_space as *const CGColorSpace).cast(),
+                    (&*expected_space as *const CGColorSpace).cast(),
+                )
+            } != 0
+        );
+        assert_eq!(CGColor::number_of_components(Some(&color)), 4);
+        let ptr = CGColor::components(Some(&color));
+        assert!(!ptr.is_null());
+        let actual = unsafe { std::slice::from_raw_parts(ptr, 4) };
+        for (actual, expected) in actual.iter().zip(components.iter()) {
+            assert!((actual - expected).abs() < 1e-12);
+        }
+        assert!((CGColor::alpha(Some(&color)) - components[3]).abs() < 1e-12);
+    }
+}
+
+#[test]
+fn layer_retains_color_after_rust_owner_is_dropped() {
+    objc::rc::autoreleasepool(|| unsafe {
+        use objc::*;
+        assert!(
+            CACurrentMediaTime() > 0.0,
+            "load the genuine framework before looking up CALayer by name"
+        );
+        let layer: *mut objc::runtime::Object = msg_send![class!(CALayer), new];
+        assert!(!layer.is_null());
+        let layer = objc::rc::StrongPtr::new(layer);
+        let color = create_srgb_color([0.125, 0.375, 0.625, 0.875]).unwrap();
+        let raw = CFRetained::as_ptr(&color).as_ptr();
+        let _: () = msg_send![*layer, setBackgroundColor:raw];
+        drop(color);
+        let stored: *mut CGColor = msg_send![*layer, backgroundColor];
+        assert_eq!(stored, raw);
+        let retained = CFRetained::retain(std::ptr::NonNull::new(stored).unwrap());
+        assert_eq!(CGColor::alpha(Some(&retained)), 0.875);
+    });
+}
