+use objc2_core_foundation::{CFRetained, CGFloat};
+use objc2_core_graphics::{kCGColorSpaceSRGB, CGColor, CGColorSpace};
+
+pub(super) fn create_srgb_color(components: [CGFloat; 4]) -> anyhow::Result<CFRetained<CGColor>> {
+    let space = CGColorSpace::with_name(Some(unsafe { kCGColorSpaceSRGB }))
+        .ok_or_else(|| anyhow::anyhow!("unable to create the named sRGB color space"))?;
+    // The named RGB space requires exactly four live CGFloat values, including alpha.
+    unsafe { CGColor::new(Some(&space), components.as_ptr()) }
+        .ok_or_else(|| anyhow::anyhow!("unable to allocate the sRGB color"))
+}
+
+#[cfg(test)]
+mod tests {
+    include!("mavericks_compat_tests.rs");
+}
