+pub(super) unsafe fn with_selector<T>(
+    receiver: cocoa::base::id,
+    selector: objc::runtime::Sel,
+    action: impl FnOnce() -> T,
+) -> Option<T> {
+    use objc::*;
+    if receiver.is_null() {
+        return None;
+    }
+    let available: objc::runtime::BOOL =
+        unsafe { msg_send![receiver, respondsToSelector:selector] };
+    if available == objc::runtime::NO {
+        None
+    } else {
+        Some(action())
+    }
+}
+
+pub(super) unsafe fn appearance_for_app(app: cocoa::base::id) -> crate::Appearance {
+    use crate::Appearance;
+    use objc::*;
+    let name = unsafe {
+        with_selector(app, sel!(effectiveAppearance), || {
+            let appearance: cocoa::base::id = msg_send![app, effectiveAppearance];
+            super::nsstring_to_str(msg_send![appearance, name]).to_string()
+        })
+    };
+    let name = match name {
+        Some(name) => name,
+        None => return Appearance::Light,
+    };
+    log::debug!("NSAppearanceName is {name}");
+    match name.as_str() {
+        "NSAppearanceNameVibrantDark" | "NSAppearanceNameDarkAqua" => Appearance::Dark,
+        "NSAppearanceNameVibrantLight" | "NSAppearanceNameAqua" => Appearance::Light,
+        "NSAppearanceNameAccessibilityHighContrastVibrantLight"
+        | "NSAppearanceNameAccessibilityHighContrastAqua" => Appearance::LightHighContrast,
+        "NSAppearanceNameAccessibilityHighContrastVibrantDark"
+        | "NSAppearanceNameAccessibilityHighContrastDarkAqua" => Appearance::DarkHighContrast,
+        _ => {
+            log::warn!("Unknown NSAppearanceName {name}, assume Light");
+            Appearance::Light
+        }
+    }
+}
