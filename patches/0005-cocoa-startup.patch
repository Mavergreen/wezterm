+        }
+        assert!(Protocol::get("NSTextInputClient").is_some());
+        let class = WindowView::get_class();
+        assert!(class.instance_method(sel!(displayLayer:)).is_some());
+        assert!(class.instance_method(sel!(drawLayer:inContext:)).is_some());
+        assert!(class.instance_method(sel!(layer:shouldInheritContentsScale:fromWindow:)).is_some());
+    }
