+#[test]
+fn absent_selectors_skip_actions_and_fall_back_to_light() {
+    use objc::*;
+    unsafe {
+        std::hint::black_box(APPLICATION);
+    }
+    objc::rc::autoreleasepool(|| unsafe {
+        let raw: cocoa::base::id = msg_send![class!(NSObject), new];
+        let object = objc::rc::StrongPtr::new(raw);
+        let invoked = std::cell::Cell::new(false);
+        for (name, selector) in [
+            ("NSApplication", sel!(effectiveAppearance)),
+            ("NSWindow", sel!(setTabbingMode:)),
+            ("NSWindow", sel!(setTitleVisibility:)),
+            ("NSWindow", sel!(setTitlebarAppearsTransparent:)),
+        ] {
+            assert!(objc::runtime::Class::get(name)
+                .unwrap()
+                .instance_method(selector)
+                .is_none());
+            assert!(with_selector(*object, selector, || invoked.set(true)).is_none());
+        }
+        assert!(!invoked.get());
+        assert!(matches!(
+            appearance_for_app(*object),
+            crate::Appearance::Light
+        ));
+        assert!(matches!(
+            appearance_for_app(cocoa::base::nil),
+            crate::Appearance::Light
+        ));
+    });
+}
