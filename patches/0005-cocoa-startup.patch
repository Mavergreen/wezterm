+            assert!(CACurrentMediaTime() > 0.0);
+            let raw: id = msg_send![class!(NSView), new];
+            let _view = StrongPtr::new(raw);
+            let _: () = msg_send![raw, setWantsLayer: YES];
+            let before: BOOL = msg_send![raw, wantsLayer];
+            assert_eq!(before, YES);
+            let _state = cglbits::GlState::create(raw).expect("genuine native CGL context");
+            let after: BOOL = msg_send![raw, wantsLayer];
+            assert_eq!(after, NO, "native CGL must not draw behind a Core Animation layer");
+        });
