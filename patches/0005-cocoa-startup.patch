+    fn unavailable_accelerated_renderer_returns_the_native_format_error() {
+        unsafe { std::hint::black_box(APPLICATION); }
+        let result = unsafe { cglbits::GlState::create_with_attributes(nil, &[
+            appkit::NSOpenGLPFARendererID as u32,
+            0x00ffff00,
+            appkit::NSOpenGLPFANoRecovery as u32,
+            appkit::NSOpenGLPFAAccelerated as u32,
+            0,
