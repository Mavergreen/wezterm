+#[test]
+fn supported_native_selector_still_performs_the_real_operation() {
+    use objc::*;
+    unsafe {
+        std::hint::black_box(APPLICATION);
+    }
+    objc::rc::autoreleasepool(|| unsafe {
+        let raw: cocoa::base::id = msg_send![class!(NSMutableDictionary), new];
+        let dictionary = objc::rc::StrongPtr::new(raw);
+        let key = super::super::nsstring("mavericks-guard-test");
+        let value = super::super::nsstring("real-native-value");
+        assert!(with_selector(*dictionary, sel!(setObject:forKey:), || {
+            let _: () = msg_send![*dictionary, setObject:*value forKey:*key];
+        })
+        .is_some());
+        let stored: cocoa::base::id = msg_send![*dictionary, objectForKey:*key];
+        assert_eq!(stored, *value);
+    });
+}
