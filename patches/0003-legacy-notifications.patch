+#![cfg(target_os = "macos")]
+#![allow(deprecated)]
+use crate::ToastNotification;
+use block2::RcBlock;
+use objc2::rc::Retained;
+use objc2::runtime::{AnyClass, AnyObject, NSObject, NSObjectProtocol, ProtocolObject};
+use objc2::{define_class, msg_send, sel, AllocAnyThread};
+use objc2_foundation::{
+    ns_string, NSDictionary, NSNotification, NSNotificationCenter, NSOperationQueue, NSPropertyListFormat, NSPropertyListSerialization,
+    NSString, NSThread, NSUserNotification, NSUserNotificationCenter,
+    NSUserNotificationCenterDelegate, NSUserNotificationDefaultSoundName,
+};
+use std::collections::{HashMap, HashSet};
+use std::sync::atomic::{AtomicPtr, Ordering};
+use std::sync::{LazyLock, Mutex, Once};
+
+type Error = Box<dyn std::error::Error>;
+
+// Genuine AppKit exports, available since 10.0 and 10.8 respectively.
+#[link(name = "AppKit", kind = "framework")]
+extern "C" {
+    static NSApplicationDidFinishLaunchingNotification: &'static NSString;
+    static NSApplicationLaunchUserNotificationKey: &'static NSString;
+}
+
+fn notification_id(notification: &NSUserNotification) -> String {
+    notification
+        .identifier()
+        .map(|id| id.to_string())
+        .unwrap_or_default()
+}
+
+#[derive(Default)]
+struct Book {
+    pending: HashMap<String, bool>,
+    // Native activations can refer to notifications from an earlier process.
+    // Keep consumed IDs for this process lifetime, separately from delivery state.
+    activated: HashSet<String>,
+}
+
+impl Book {
+    fn track(&mut self, notification: &NSUserNotification) {
+        self.pending.insert(notification_id(notification), false);
+    }
+
+    fn delivered(&mut self, notification: &NSUserNotification) {
+        if let Some(delivered) = self.pending.get_mut(&notification_id(notification)) {
+            *delivered = true;
+        }
+    }
+
+    fn purge_dismissed(&mut self, live: &HashSet<String>) {
+        self.pending
+            .retain(|id, delivered| !*delivered || live.contains(id));
+    }
+
+    fn delivery_failed(&mut self, notification: &NSUserNotification) -> bool {
+        let id = notification_id(notification);
+        if self.pending.get(&id) == Some(&false) {
+            self.pending.remove(&id);
+            true
+        } else {
+            false
+        }
+    }
+}
+
+static BOOK: LazyLock<Mutex<Book>> = LazyLock::new(|| Mutex::new(Book::default()));
+
+fn activate_with(notification: &NSUserNotification, book: &Mutex<Book>, open: impl FnOnce(&str)) {
+    let id = notification_id(notification);
+    if id.is_empty() {
+        log::error!("cannot activate native notification without an identifier");
+        return;
+    }
+    {
+        let mut book = book.lock().unwrap();
+        if !book.activated.insert(id.clone()) {
+            return;
+        }
+        book.pending.remove(&id);
+    }
+    if let Some(info) = notification.userInfo() {
+        if let Some(url) = info.objectForKey(ns_string!("url")) {
+            if let Some(url) = url.downcast_ref::<NSString>() {
+                open(&url.to_string());
+            }
+        }
+    }
+}
+
+fn launch_notification(notification: &NSNotification) -> Option<Retained<NSUserNotification>> {
+    let info = notification.userInfo()?;
+    let value = info.objectForKey(unsafe { NSApplicationLaunchUserNotificationKey })?;
+    value.downcast::<NSUserNotification>().ok()
+}
+
+fn expire_with(
+    notification: &NSUserNotification,
+    book: &Mutex<Book>,
+    remove: impl FnOnce(&NSUserNotification),
+) {
+    if book
+        .lock()
+        .unwrap()
+        .pending
+        .remove(&notification_id(notification))
+        .is_some()
+    {
+        remove(notification);
+    }
+}
+
+fn notification_center(
+    class: Option<&AnyClass>,
+) -> Result<Retained<NSUserNotificationCenter>, Error> {
+    let class = class.ok_or("NSUserNotificationCenter unavailable on this system")?;
+    let available: bool =
+        unsafe { msg_send![class, respondsToSelector: sel!(defaultUserNotificationCenter)] };
+    if !available {
+        return Err("native notification delivery API unavailable".into());
+    }
+    let center: Option<Retained<NSUserNotificationCenter>> =
+        unsafe { msg_send![class, defaultUserNotificationCenter] };
+    center.ok_or_else(|| {
+        "native notification center unavailable; check the app bundle and user session".into()
+    })
+}
+
+fn center() -> Result<Retained<NSUserNotificationCenter>, Error> {
+    notification_center(AnyClass::get(
+        std::ffi::CStr::from_bytes_with_nul(b"NSUserNotificationCenter\0").unwrap(),
+    ))
+}
+
+fn make_notification(toast: &ToastNotification) -> Result<Retained<NSUserNotification>, Error> {
+    AnyClass::get(std::ffi::CStr::from_bytes_with_nul(b"NSUserNotification\0").unwrap())
+        .ok_or("NSUserNotification unavailable on this system")?;
+    let notification = NSUserNotification::new();
+    notification.setIdentifier(Some(&NSString::from_str(&uuid::Uuid::new_v4().to_string())));
+    notification.setTitle(Some(&NSString::from_str(&toast.title)));
+    notification.setInformativeText(Some(&NSString::from_str(&toast.message)));
+    notification.setSoundName(Some(unsafe { NSUserNotificationDefaultSoundName }));
+    if let Some(url) = &toast.url {
+        let url = NSString::from_str(url);
+        let info = NSDictionary::<NSString, AnyObject>::from_slices(&[ns_string!("url")], &[&url]);
+        let data = unsafe {
+            NSPropertyListSerialization::dataWithPropertyList_format_options_error(
+                &info,
+                NSPropertyListFormat::BinaryFormat_v1_0,
+                0,
+            )
+        }
+        .map_err(|error| format!("cannot encode notification userInfo: {error:?}"))?;
+        if data.length() >= 1024 {
+            return Err("notification userInfo exceeds the Mavericks native 1 KiB limit".into());
+        }
+        unsafe {
+            notification.setUserInfo(Some(&info));
+        }
+        notification.setHasActionButton(true);
+        notification.setActionButtonTitle(ns_string!("Show"));
+    }
+    Ok(notification)
+}
+
+define_class!(
+    #[unsafe(super = NSObject)]
+    #[name = "WezTermLegacyNotifDelegate"]
+    #[derive(Debug)]
+    struct Delegate;
+
+    unsafe impl NSObjectProtocol for Delegate {}
+
+    unsafe impl NSUserNotificationCenterDelegate for Delegate {
+        #[unsafe(method(userNotificationCenter:shouldPresentNotification:))]
+        fn should_present(&self, _center: &NSUserNotificationCenter, _notification: &NSUserNotification) -> bool {
+            true
+        }
+
+        #[unsafe(method(userNotificationCenter:didDeliverNotification:))]
+        fn did_deliver(&self, _center: &NSUserNotificationCenter, notification: &NSUserNotification) {
+            BOOK.lock().unwrap().delivered(notification);
+        }
+
+        #[unsafe(method(userNotificationCenter:didActivateNotification:))]
+        fn did_activate(&self, center: &NSUserNotificationCenter, notification: &NSUserNotification) {
+            activate_with(notification, &BOOK, wezterm_open_url::open_url);
+            center.removeDeliveredNotification(notification);
+        }
+    }
+
+    impl Delegate {
+        #[unsafe(method(applicationDidFinishLaunching:))]
+        fn application_did_finish_launching(&self, launch: &NSNotification) {
+            if let Some(notification) = launch_notification(launch) {
+                activate_with(&notification, &BOOK, wezterm_open_url::open_url);
+                match center() {
+                    Ok(center) => center.removeDeliveredNotification(&notification),
+                    Err(error) => log::error!("cannot remove activated launch notification: {error}"),
+                }
+            }
+        }
+
+        #[unsafe(method(expireNotification:))]
+        fn expire(&self, notification: &NSUserNotification) {
+            match center() {
+                Ok(center) => expire_with(notification, &BOOK, |notification| center.removeDeliveredNotification(notification)),
+                Err(error) => log::error!("cannot expire notification: {error}"),
+            }
+        }
+
+        #[unsafe(method(checkDelivery:))]
+        fn check_delivery(&self, notification: &NSUserNotification) {
+            match center() {
+                Ok(center) => {
+                    let id = notification_id(notification);
+                    if center.deliveredNotifications().iter().any(|item| notification_id(&item) == id) {
+                        BOOK.lock().unwrap().delivered(notification);
+                    }
+                    if BOOK.lock().unwrap().delivery_failed(notification) {
+                        log::error!("native notification {id} was not delivered; check app identity, signing and user session");
+                    }
+                }
+                Err(error) => log::error!("cannot check notification delivery: {error}"),
+            }
+        }
+    }
+);
+
+fn retained_delegate() -> Retained<Delegate> {
+    static INIT: Once = Once::new();
+    static DELEGATE: AtomicPtr<Delegate> = AtomicPtr::new(std::ptr::null_mut());
+    INIT.call_once(|| {
+        let allocated = Delegate::alloc().set_ivars(());
+        let delegate: Retained<Delegate> = unsafe { msg_send![super(allocated), init] };
+        // NSApplication posts the same launch notification that it sends to its
+        // delegate. Observe it before run(), including launches with no new toast.
+        // The observer and its registration intentionally share process lifetime.
+        unsafe {
+            NSNotificationCenter::defaultCenter().addObserver_selector_name_object(
+                &delegate, sel!(applicationDidFinishLaunching:),
+                Some(NSApplicationDidFinishLaunchingNotification), None);
+        }
+        DELEGATE.store(Retained::into_raw(delegate), Ordering::Release);
+    });
+    unsafe { Retained::retain(DELEGATE.load(Ordering::Acquire)).unwrap() }
+}
+
+fn initialize_on_main() -> Result<Retained<NSUserNotificationCenter>, Error> {
+    let delegate = retained_delegate();
+    let center = center()?;
+    unsafe {
+        center.setDelegate(Some(ProtocolObject::from_ref(&*delegate)));
+    }
+    Ok(center)
+}
+
+pub fn initialize() {
+    if NSThread::isMainThread_class() {
+        if let Err(error) = initialize_on_main() {
+            log::error!("cannot initialize native notifications: {error}");
+        }
+    } else {
+        let operation = RcBlock::new(initialize);
+        unsafe {
+            NSOperationQueue::mainQueue().addOperationWithBlock(&operation);
+        }
+    }
+}
+
+fn show_on_main(toast: ToastNotification) -> Result<(), Error> {
+    let center = initialize_on_main()?;
+    let notification = make_notification(&toast)?;
+    let live = center
+        .deliveredNotifications()
+        .iter()
+        .map(|item| notification_id(&item))
+        .collect();
+    {
+        let mut book = BOOK.lock().unwrap();
+        book.purge_dismissed(&live);
+        book.track(&notification);
+    }
+    center.deliverNotification(&notification);
+    let delegate = retained_delegate();
+    unsafe {
+        let _: () = msg_send![&*delegate, performSelector: sel!(checkDelivery:) withObject: &*notification afterDelay: 5.0f64];
+        if let Some(timeout) = toast.timeout {
+            let _: () = msg_send![&*delegate, performSelector: sel!(expireNotification:) withObject: &*notification afterDelay: timeout.as_secs_f64()];
+        }
+    }
+    Ok(())
+}
+
+pub fn show_notif(toast: ToastNotification) -> Result<(), Error> {
+    if NSThread::isMainThread_class() {
+        show_on_main(toast)
+    } else {
+        let operation = RcBlock::new(move || {
+            if let Err(error) = show_on_main(toast.clone()) {
+                log::error!("native notification delivery failed: {error}");
+            }
+        });
+        unsafe {
+            NSOperationQueue::mainQueue().addOperationWithBlock(&operation);
+        }
+        Ok(())
+    }
+}
