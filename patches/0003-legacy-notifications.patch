+use super::*;
+use objc2::rc::Weak;
+
+fn toast(url: Option<&str>) -> ToastNotification {
+    ToastNotification {
+        title: "Mavericks title".into(),
+        message: "Native body — café".into(),
+        url: url.map(str::to_string),
+        timeout: Some(std::time::Duration::from_secs(3)),
+    }
+}
+
+#[test]
+fn title_and_body_reach_native_notification() {
+    let notification = make_notification(&toast(Some("https://example.invalid/test"))).unwrap();
+    assert_eq!(notification.title().unwrap().to_string(), "Mavericks title");
+    assert_eq!(
+        notification.informativeText().unwrap().to_string(),
+        "Native body — café"
+    );
+    assert!(notification.hasActionButton());
+    let info = notification.userInfo().unwrap();
+    let url = info.objectForKey(ns_string!("url")).unwrap();
+    assert_eq!(
+        url.downcast_ref::<NSString>().unwrap().to_string(),
+        "https://example.invalid/test"
+    );
+}
+
+#[test]
+fn url_click_opens_the_configured_url_once() {
+    let notification = make_notification(&toast(Some("https://example.invalid/click"))).unwrap();
+    let book = Mutex::new(Book::default());
+    book.lock().unwrap().track(&notification);
+    let mut opened = Vec::new();
+    for _ in 0..2 {
+        activate_with(&notification, &book, |url| opened.push(url.to_string()));
+    }
+    assert_eq!(opened, vec!["https://example.invalid/click"]);
+}
+
+#[test]
+fn persistent_click_after_restart_opens_once_without_process_local_pending_state() {
+    let notification = make_notification(&toast(Some("https://example.invalid/restarted"))).unwrap();
+    let restarted_book = Mutex::new(Book::default());
+    let mut opened = Vec::new();
+    for _ in 0..2 {
+        activate_with(&notification, &restarted_book, |url| {
+            assert!(restarted_book.try_lock().is_ok(), "opening can reenter");
+            opened.push(url.to_string());
+        });
+    }
+    assert_eq!(opened, vec!["https://example.invalid/restarted"]);
+}
+
+#[test]
+fn native_application_launch_notification_reaches_activation_before_first_toast() {
+    // The framework key and genuine Foundation broadcast exercise the registered
+    // selector, without launching another application or requesting a real banner.
+    use objc2_foundation::NSNotificationCenter;
+    #[link(name = "AppKit", kind = "framework")]
+    extern "C" {
+        static NSApplicationDidFinishLaunchingNotification: &'static NSString;
+        static NSApplicationLaunchUserNotificationKey: &'static NSString;
+    }
+    let _owner = retained_delegate();
+    let notification = make_notification(&toast(None)).unwrap();
+    BOOK.lock().unwrap().track(&notification);
+    let info = NSDictionary::<NSString, AnyObject>::from_slices(
+        &[unsafe { NSApplicationLaunchUserNotificationKey }], &[&*notification]);
+    // Erase only lightweight generics: every NSString key is an NSObject.
+    let info: Retained<NSDictionary> = unsafe { Retained::cast_unchecked(info) };
+    unsafe {
+        NSNotificationCenter::defaultCenter().postNotificationName_object_userInfo(
+            NSApplicationDidFinishLaunchingNotification, None, Some(&info));
+    }
+    assert!(!BOOK.lock().unwrap().pending.contains_key(&notification_id(&notification)),
+            "the registered native launch observer must consume the activation");
+}
+
+#[test]
+fn cold_launch_payload_opens_persisted_url_and_later_delegate_activation_is_a_duplicate() {
+    let notification = make_notification(&toast(Some("https://example.invalid/cold-launch"))).unwrap();
+    let info = NSDictionary::<NSString, AnyObject>::from_slices(
+        &[unsafe { NSApplicationLaunchUserNotificationKey }], &[&*notification]);
+    let launch = unsafe {
+        NSNotification::notificationWithName_object_userInfo(
+            NSApplicationDidFinishLaunchingNotification, None, info.downcast_ref::<NSDictionary>())
+    };
+    let activated = launch_notification(&launch).expect("native launch key contains our notification");
+    let restarted_book = Mutex::new(Book::default());
+    let mut opened = Vec::new();
+    activate_with(&activated, &restarted_book, |url| opened.push(url.to_string()));
+    activate_with(&notification, &restarted_book, |url| opened.push(url.to_string()));
+    assert_eq!(opened, vec!["https://example.invalid/cold-launch"]);
+}
+
+#[test]
+fn ordinary_or_malformed_launch_payloads_are_not_activations() {
+    let ordinary = unsafe { NSNotification::notificationWithName_object_userInfo(
+        NSApplicationDidFinishLaunchingNotification, None, None) };
+    assert!(launch_notification(&ordinary).is_none());
+    let info = NSDictionary::<NSString, AnyObject>::from_slices(
+        &[unsafe { NSApplicationLaunchUserNotificationKey }], &[ns_string!("not a notification")]);
+    let malformed = unsafe { NSNotification::notificationWithName_object_userInfo(
+        NSApplicationDidFinishLaunchingNotification, None, info.downcast_ref::<NSDictionary>()) };
+    assert!(launch_notification(&malformed).is_none());
+}
+
+#[test]
+fn unidentified_notifications_do_not_open_urls() {
+    let notification = make_notification(&toast(Some("https://example.invalid/no-id"))).unwrap();
+    notification.setIdentifier(None);
+    let book = Mutex::new(Book::default());
+    let mut opened = Vec::new();
+    activate_with(&notification, &book, |url| opened.push(url.to_string()));
+    assert!(opened.is_empty());
+}
+
+#[test]
+fn timeout_removes_only_its_own_notification() {
+    let first = make_notification(&toast(None)).unwrap();
+    let second = make_notification(&toast(None)).unwrap();
+    let book = Mutex::new(Book::default());
+    book.lock().unwrap().track(&first);
+    book.lock().unwrap().track(&second);
+    let mut removed = Vec::new();
+    expire_with(&first, &book, |n| {
+        assert!(
+            book.try_lock().is_ok(),
+            "native removal may reenter; do not hold our state lock"
+        );
+        removed.push(notification_id(n));
+    });
+    expire_with(&first, &book, |n| removed.push(notification_id(n)));
+    assert_eq!(removed, vec![notification_id(&first)]);
+    assert!(book
+        .lock()
+        .unwrap()
+        .pending
+        .contains_key(&notification_id(&second)));
+}
+
+#[test]
+fn dismissed_delivered_notifications_do_not_accumulate_in_the_book() {
+    let delivered = make_notification(&toast(None)).unwrap();
+    let awaiting = make_notification(&toast(None)).unwrap();
+    let mut book = Book::default();
+    book.track(&delivered);
+    book.delivered(&delivered);
+    book.track(&awaiting);
+    book.purge_dismissed(&std::collections::HashSet::new());
+    assert!(!book.pending.contains_key(&notification_id(&delivered)));
+    assert!(book.pending.contains_key(&notification_id(&awaiting)));
+}
+
+#[test]
+fn missing_native_delivery_api_is_reported() {
+    let error = notification_center(None).unwrap_err().to_string();
+    assert!(error.contains("unavailable"), "{}", error);
+}
+
+#[test]
+fn undelivered_request_is_reported_but_delivered_request_is_not() {
+    let first = make_notification(&toast(None)).unwrap();
+    let second = make_notification(&toast(None)).unwrap();
+    let mut book = Book::default();
+    book.track(&first);
+    book.track(&second);
+    book.delivered(&second);
+    assert!(book.delivery_failed(&first));
+    assert!(!book.delivery_failed(&first));
+    assert!(!book.delivery_failed(&second));
+}
+
+#[test]
+fn oversized_native_user_info_is_an_explicit_error() {
+    let url = "x".repeat(4096);
+    let error = make_notification(&toast(Some(&url)))
+        .unwrap_err()
+        .to_string();
+    assert!(error.contains("userInfo"), "{}", error);
+}
+
+#[test]
+fn delegate_remains_alive_after_initialization_local_is_dropped() {
+    let delegate = retained_delegate();
+    let weak = Weak::from_retained(&delegate);
+    let pointer = Retained::as_ptr(&delegate);
+    drop(delegate);
+    let alive = weak
+        .load()
+        .expect("notification center does not retain its delegate; our owner must");
+    assert_eq!(Retained::as_ptr(&alive), pointer);
+    assert_eq!(Retained::as_ptr(&retained_delegate()), pointer);
+}
