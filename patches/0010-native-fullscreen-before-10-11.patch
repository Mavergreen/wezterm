+/// Before macOS 10.11, toggleFullScreen: does nothing unless the window
+/// opted in with NSWindowCollectionBehaviorFullScreenPrimary; 10.11 and
+/// later give resizable windows that behavior by default.
+const NS_WINDOW_COLLECTION_BEHAVIOR_FULL_SCREEN_PRIMARY: NSUInteger = 1 << 7;
+
+unsafe fn new_ns_window(rect: NSRect, style_mask: NSWindowStyleMask) -> StrongPtr {
+    let window: id = msg_send![get_window_class(), alloc];
+    let window = StrongPtr::new(NSWindow::initWithContentRect_styleMask_backing_defer_(
+        window,
+        rect,
+        style_mask,
+        NSBackingStoreBuffered,
+        NO,
+    ));
+    let behavior: NSUInteger = msg_send![*window, collectionBehavior];
+    let () = msg_send![
+        *window,
+        setCollectionBehavior: behavior | NS_WINDOW_COLLECTION_BEHAVIOR_FULL_SCREEN_PRIMARY
+    ];
+    window
+}
