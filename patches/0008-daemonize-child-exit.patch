+/// Reports `err` and ends a process that `daemonize` forked, before it
+/// execs, with `_exit(2)`.
+///
+/// The process that forked may have had other threads (loading the
+/// configuration starts notify's FSEvents thread on macOS), so until it
+/// execs, the forked child must not depend on state that the fork copied
+/// from them.  `exit(3)` would: it runs the thread-local destructors, and on
+/// macOS the one for the main thread's handle releases the dispatch semaphore
+/// that std parks that thread on.  If the thread parked before the fork, the
+/// semaphore owns a Mach semaphore, which the child does not inherit, and
+/// libdispatch kills the child with SIGILL ("BUG IN LIBDISPATCH: flawed
+/// group/semaphore logic").  Nor does it use `log`, whose lock another
+/// thread may have held at the fork.
+pub fn exit_forked_child(err: impl std::fmt::Display) -> ! {
+    let message = format!("wezterm-mux-server: {err:#}\n");
+    unsafe {
+        libc::write(
+            libc::STDERR_FILENO,
+            message.as_ptr() as *const libc::c_void,
+            message.len(),
+        );
+        libc::_exit(1)
+    }
+}
